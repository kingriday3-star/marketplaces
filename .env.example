# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: Server port (default 3000)
PORT=3000

# Real Gmail 6-Digit OTP Email Delivery via Gmail SMTP (recommended)
# Generate a 16-character App Password in Google Account -> Security -> 2-Step Verification -> App passwords
# GMAIL_USER="yourgmail@gmail.com"
# GMAIL_APP_PASSWORD=""

# Optional Generic SMTP Server (alternative to Gmail SMTP)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=465
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM_EMAIL="Market places <noreply@example.com>"

# Optional Email OTP delivery via Resend (https://resend.com)
# RESEND_API_KEY=""
# RESEND_FROM_EMAIL="Market places <noreply@example.com>"

# Optional SMS OTP delivery via Twilio
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_PHONE_NUMBER=""
